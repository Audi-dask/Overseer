# 复制为 .env 后修改：cp .env.example .env
# MASTER_KEY 用于加密 GitLab Token / LLM API Key，变更后需重新填写凭证（生产环境请固定，勿每次重启随机生成）
MASTER_KEY=change-me-use-openssl-rand-hex-32

# 镜像地址（默认腾讯云 CCR；本地构建可用 docker compose up --build）
# OVERSEER_IMAGE=ccr.ccs.tencentyun.com/audi-dask/overseer:20260730-fix1

# 可选：预置管理员密码，跳过首次设置页
# ADMIN_PASSWORD=your-admin-password

# 宿主机映射端口
PORT=8080
